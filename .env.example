DEBUG=True
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Use the transaction pooler (port 6543), not session mode (5432) — session
# mode caps concurrent clients at 15 and gets exhausted by a normal web app.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:6543/postgres

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

# Web Push (desktop + mobile browser notifications). Generate once with:
#   python -c "from py_vapid import Vapid02; import base64; v=Vapid02(); v.generate_keys(); from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).decode().rstrip('=')); print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_numbers().private_value.to_bytes(32,'big')).decode().rstrip('='))"
# Keep the same pair across deploys — regenerating invalidates every
# existing visitor's push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

# Email (contact form). No provider has been chosen yet — set EMAIL_HOST/
# EMAIL_HOST_USER/EMAIL_HOST_PASSWORD (and EMAIL_PORT if not 587) once one
# is (SMTP relay for SendGrid/SES/Mailgun/Postmark/etc. all work the same
# way here). Leaving EMAIL_HOST blank keeps using the console backend
# (prints to stdout, no real delivery) — EMAIL_BACKEND only needs setting
# explicitly for a non-SMTP (API-based) provider package; it otherwise
# switches to the real SMTP backend automatically once EMAIL_HOST is set.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=ctaftelaneebusinesses@gmail.com
SERVER_EMAIL=noreply@hellokuppam.com
CONTACT_RECEIVER_EMAIL=ctaftelaneebusinesses@gmail.com

# SHA-256 fingerprint of the Android release signing certificate (for
# /.well-known/assetlinks.json — App Links verification). Leave empty until
# a real production keystore exists; do not fill in a debug/test cert's
# fingerprint here.
ANDROID_RELEASE_CERT_SHA256=
